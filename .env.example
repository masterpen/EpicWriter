# ======================
# Neo4j Database
# ======================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ======================
# OpenAI / DeepSeek API
# ======================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com

# ======================
# OpenRouter (可选)
# ======================
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ======================
# JWT Secret Key
# 生产环境 (APP_ENV=production) 必须修改为 >=16 字符的随机字符串，
# 否则启动时会抛出 ValueError 拒绝加载。
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ======================
JWT_SECRET_KEY=your_super_secret_key_change_in_production

# ======================
# LLM Default Config (可选)
# ======================
# 如果用户未通过API配置，将使用此处默认值
# 用户可在前端 /api/config/llm 动态配置

# ======================
# App Settings
# ======================
APP_ENV=development
